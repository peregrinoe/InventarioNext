# ─────────────────────────────────────────────────────────────
# Variables de entorno para la API (api/)
# Copia este archivo como .env para desarrollo local:
#   cp .env.example api/.env
#
# En producción (Cloud Run) configura estas variables
# desde la consola de GCP: Cloud Run → Servicio → Variables y secretos
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# Puerto local del servidor API
PORT=3000

# ── Base de datos (Cloud SQL - PostgreSQL) ──────────────────────
# Producción: Cloud Run conecta vía Unix socket automáticamente
# Desarrollo: conexión TCP a localhost o Cloud SQL Proxy
DB_USER=postgres
DB_PASSWORD=CAMBIA_ESTE_PASSWORD
DB_NAME=inventario
DB_HOST=localhost
DB_PORT=5432

# Solo en producción (Cloud Run):
# Formato: PROJECT_ID:REGION:INSTANCE_NAME
# Ejemplo: mi-proyecto:us-central1:inventario-db
INSTANCE_CONNECTION_NAME=

# ── JWT ─────────────────────────────────────────────────────────
# Genera una clave segura:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTA_CLAVE_SECRETA_LARGA
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────────
# Lista de dominios permitidos (separados por coma)
# Ejemplo: https://mi-frontend.a.run.app,https://mi-dominio.com
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5500
